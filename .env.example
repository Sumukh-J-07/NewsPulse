# NewsPulse Environment Configuration

# Application mode: "sample" (default, deterministic & offline) or "live" (yfinance + RSS)
NEWSPULSE_MODE=sample

# Watchlist configuration path (defaults to config/watchlist.sample.json or config/watchlist.nse.json)
# NEWSPULSE_WATCHLIST=config/watchlist.sample.json

# SQLite Database path (defaults to data/newspulse_sample.db or data/newspulse_live.db)
# NEWSPULSE_DB_PATH=data/newspulse_sample.db

# Outlook classification deadband threshold in percentage points (default: 0.25)
NEWSPULSE_THRESHOLD_PP=0.25

# Freshness limits
NEWSPULSE_PRICE_MAX_AGE_DAYS=4
NEWSPULSE_NEWS_MAX_AGE_HOURS=36.0

# Sentiment recency weighting half-life in hours (default: 12.0)
NEWSPULSE_RECENCY_HALF_LIFE_HOURS=12.0

# Operator token for protected refresh endpoint (leave blank to disable refresh endpoint)
NEWSPULSE_OPERATOR_TOKEN=
